#!/usr/bin/env bash
#
# mayfly — ephemeral HTML previews via GitHub Actions artifacts.
#
#   mayfly push   [-b <branch>] -f <file> [-f <file> ...] [--open]  # throwaway preview
#   mayfly keep   -p <path> -f <file> [-b <branch>] [--open]        # promote: open a PR
#   mayfly list                                                     # list live previews
#   mayfly delete (-b <branch> ... | --all-previews)                # delete branches
#   mayfly completion <bash|zsh>                                    # shell completion
#
# stdout is JSON only; progress goes to stderr (so `mayfly ... | jq` works).
#
set -euo pipefail

PROG="mayfly"
PREVIEW_PREFIX="preview/"   # auto-generated throwaway branches
DOCS_DIR="docs"             # keep target / GitHub Pages publish root

usage() {
  cat <<EOF
Usage:
  $PROG push   [-b <branch>] -f <file> [-f <file> ...] [--open]
  $PROG keep   -p <path> -f <file> [-b <branch>] [--open]
  $PROG list
  $PROG delete (-b <branch> [-b <branch> ...] | --all-previews)
  $PROG integrate [--force]
  $PROG completion <bash|zsh>

Commands:
  push     Publish files to a throwaway branch (auto 'preview/<ts>-<rnd>' if -b
           is omitted) and print per-file artifact preview URLs as JSON.
  keep     Promote a file to the default branch by opening a PR that places it
           at ${DOCS_DIR}/<path> (served by GitHub Pages once merged). Source is a
           local file (-f), or a file on a preview branch (-b <branch> -f <name>).
  list     List live preview/* branches with their latest run.
  delete   Delete one or more branches, or every preview/* branch.
  integrate Scaffold previews into the current repo: a push-triggered workflow
           for mayfly/* branches plus a separate repo-local CLI
           (.github/mayfly-preview) that posts a local file's preview onto a PR.

Options:
  -b, --branch <name>   Branch (push: target; keep: source preview branch; delete: target).
  -f, --file <path>     File (repeatable for push).
  -p, --path <path>     Destination path under ${DOCS_DIR}/ (keep; = the Pages URL path).
  -m, --message <msg>   Commit / PR message.
  -r, --repo <o/n>      Target repo "owner/name".
      --open            Open the resulting URL in your browser.
      --all-previews    (delete) remove every ${PREVIEW_PREFIX}* branch.
  -h, --help            Show this help.

Repo: --repo > \$MAYFLY_REPO > the repo mayfly itself lives in (not \$PWD).
EOF
}

json_escape() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

# Absolute directory of this script, with symlinks resolved. mayfly is usually
# symlinked onto PATH, so $PWD is wherever you happen to be — but the repo we
# want is the one mayfly *lives in*. Anchor detection there, not on $PWD.
script_dir() {
  local src="${BASH_SOURCE[0]}" dir
  while [ -L "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src";; esac
  done
  cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd
}

resolve_repo() {
  local r="${REPO_ARG:-${MAYFLY_REPO:-}}"
  # Default to the repo mayfly itself sits in (resolving from its own location,
  # not $PWD), so running it from inside some other checkout doesn't hijack the
  # target. --repo and $MAYFLY_REPO still override.
  [ -z "$r" ] && r="$( (cd "$(script_dir)" 2>/dev/null && gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null) || true)"
  [ -n "$r" ] || { echo "$PROG: cannot determine repo; set MAYFLY_REPO, use --repo, or run mayfly from inside its repo clone" >&2; exit 1; }
  printf '%s' "$r"
}

open_url() {
  [ -n "${1:-}" ] || return 0
  case "$(uname)" in
    Darwin) open "$1" >/dev/null 2>&1 || true;;
    *)      xdg-open "$1" >/dev/null 2>&1 || true;;
  esac
}

gen_branch() { printf '%s%s-%s' "$PREVIEW_PREFIX" "$(date +%Y%m%d-%H%M%S)" "$RANDOM"; }

ensure_branch() {
  local repo="$1" branch="$2" head def base
  if head="$(gh api "repos/$repo/git/ref/heads/$branch" -q .object.sha 2>/dev/null)"; then
    printf '%s' "$head"; return
  fi
  def="$(gh api "repos/$repo" -q .default_branch)"
  base="$(gh api "repos/$repo/git/ref/heads/$def" -q .object.sha)"
  gh api -X POST "repos/$repo/git/refs" -f ref="refs/heads/$branch" -f sha="$base" >/dev/null
  echo "$PROG: created branch '$branch'" >&2
  printf '%s' "$base"
}

FIRST_URL=""

# `push` only yields a preview if the target repo has the push-triggered preview
# workflow (.github/workflows/preview.yml). Without it the commit just sits on a
# dead branch and the run-watch loop times out 2 minutes later. Detect that
# up front, before committing anything, and explain how to fix it.
assert_push_capable() {
  local repo="$1"
  gh api "repos/$repo/contents/.github/workflows/preview.yml" -q .name >/dev/null 2>&1 && return 0
  cat >&2 <<EOF
$PROG: '$repo' is not a mayfly repo — no .github/workflows/preview.yml.
$PROG: 'push' relies on that workflow to turn the commit into a browser-viewable
$PROG: artifact; it only exists in repos created from the mayfly template.
$PROG: nothing was committed. fix one of:
$PROG:   - point at a mayfly repo:   --repo <owner/name>   or   export MAYFLY_REPO=<owner/name>
$PROG:   - for an existing repo:     run 'mayfly integrate' there, then preview with
$PROG:                               '.github/mayfly-preview -f <file> --pr <N>'  (not 'push')
EOF
  exit 1
}

# publish <repo> <branch> <message> <file>...  (files committed at basename, root)
publish() {
  local REPO="$1" BRANCH="$2" MESSAGE="$3"; shift 3
  FIRST_URL=""
  assert_push_capable "$REPO"
  # Validate inputs before creating a branch, so a typo'd path can't leave a
  # stray empty branch behind.
  local path
  for path in "$@"; do
    [ -f "$path" ] || { echo "$PROG: file not found: $path" >&2; exit 1; }
  done

  local HEAD_SHA BASE_TREE
  HEAD_SHA="$(ensure_branch "$REPO" "$BRANCH")"
  BASE_TREE="$(gh api "repos/$REPO/git/commits/$HEAD_SHA" -q .tree.sha)"

  TMPD="$(mktemp -d)"; trap 'rm -rf "${TMPD:-}"' EXIT

  local TREE_ENTRIES="" USED="" path base dest stem ext n blob
  local DESTLIST=() SRCLIST=()
  for path in "$@"; do
    [ -f "$path" ] || { echo "$PROG: file not found: $path" >&2; exit 1; }
    base="$(basename "$path")"
    # A non-zipped artifact is keyed by its file basename, so basenames must be
    # unique. Rather than reject collisions, rename "<stem>.<ext>" to
    # "<stem>-N.<ext>" (extension preserved so the browser still renders it).
    stem="$base"; ext=""
    case "$base" in *.*) stem="${base%.*}"; ext=".${base##*.}";; esac
    dest="$base"; n=1
    while case " $USED " in *" $dest "*) true;; *) false;; esac; do
      n=$((n + 1)); dest="$stem-$n$ext"
    done
    USED="$USED $dest"; DESTLIST+=("$dest"); SRCLIST+=("$path")
    { printf '{"encoding":"base64","content":"'; base64 < "$path" | tr -d '\n'; printf '"}'; } > "$TMPD/blob.json"
    blob="$(gh api -X POST "repos/$REPO/git/blobs" --input "$TMPD/blob.json" -q .sha)"
    TREE_ENTRIES="${TREE_ENTRIES:+$TREE_ENTRIES,}{\"path\":\"$dest\",\"mode\":\"100644\",\"type\":\"blob\",\"sha\":\"$blob\"}"
    if [ "$dest" = "$base" ]; then echo "$PROG: staged $dest" >&2; else echo "$PROG: staged $dest (renamed from $base)" >&2; fi
  done

  printf '{"base_tree":"%s","tree":[%s]}' "$BASE_TREE" "$TREE_ENTRIES" > "$TMPD/tree.json"
  local NEW_TREE NEW_COMMIT RUN_ID="" i ART_LIST=""
  NEW_TREE="$(gh api -X POST "repos/$REPO/git/trees" --input "$TMPD/tree.json" -q .sha)"

  if [ "$NEW_TREE" = "$BASE_TREE" ]; then
    echo "$PROG: no changes to publish on $BRANCH (already up to date)" >&2
  else
    NEW_COMMIT="$(gh api -X POST "repos/$REPO/git/commits" \
      -f message="$MESSAGE" -f tree="$NEW_TREE" -f "parents[]=$HEAD_SHA" -q .sha)"
    gh api -X PATCH "repos/$REPO/git/refs/heads/$BRANCH" -f sha="$NEW_COMMIT" >/dev/null
    echo "$PROG: committed ${#DESTLIST[@]} file(s) to $REPO@$BRANCH ($NEW_COMMIT)" >&2

    echo -n "$PROG: waiting for the workflow to start" >&2
    for i in $(seq 1 40); do
      RUN_ID="$(gh api "repos/$REPO/actions/runs?head_sha=$NEW_COMMIT&event=push&per_page=1" -q '.workflow_runs[0].id // empty')"
      [ -n "$RUN_ID" ] && break
      echo -n "." >&2; sleep 3
    done
    echo >&2
    [ -n "$RUN_ID" ] || { echo "$PROG: timed out finding workflow run" >&2; exit 1; }
    # Live job/step progress to stderr (stdout stays JSON-only).
    echo "$PROG: building preview — https://github.com/$REPO/actions/runs/$RUN_ID" >&2
    gh run watch "$RUN_ID" -R "$REPO" --interval 2 --exit-status 1>&2 || \
      echo "$PROG: warning: run did not complete cleanly; URLs may be missing" >&2
    ART_LIST="$(gh api "repos/$REPO/actions/runs/$RUN_ID/artifacts" -q '.artifacts[] | "\(.name)\t\(.id)"' 2>/dev/null || true)"
  fi

  local FILES_JSON="" i dest src id url urljson entry
  for i in "${!DESTLIST[@]}"; do
    dest="${DESTLIST[$i]}"; src="${SRCLIST[$i]}"
    id="$(printf '%s\n' "$ART_LIST" | awk -F'\t' -v n="$dest" '$1==n{print $2; exit}')"
    if [ -n "$id" ]; then
      url="https://github.com/$REPO/actions/runs/$RUN_ID/artifacts/$id"
      [ -z "$FIRST_URL" ] && FIRST_URL="$url"
      urljson="\"$(json_escape "$url")\""
    else
      urljson="null"
    fi
    entry="    { \"source\": \"$(json_escape "$src")\", \"name\": \"$(json_escape "$dest")\", \"url\": $urljson }"
    FILES_JSON="${FILES_JSON:+$FILES_JSON,
}$entry"
  done

  cat <<EOF
{
  "branch": { "name": "$(json_escape "$BRANCH")", "url": "$(json_escape "https://github.com/$REPO/tree/$BRANCH")" },
  "files": [
$FILES_JSON
  ]
}
EOF
}

cmd_push() {
  local BRANCH="" MESSAGE="" OPEN=0; FILES=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -b|--branch)  BRANCH="$2"; shift 2;;
      -f|--file)    FILES+=("$2"); shift 2;;
      -m|--message) MESSAGE="$2"; shift 2;;
      -r|--repo)    REPO_ARG="$2"; shift 2;;
      --open)       OPEN=1; shift;;
      -h|--help)    usage; exit 0;;
      *) echo "$PROG: unknown argument: $1" >&2; usage; exit 1;;
    esac
  done
  [ "${#FILES[@]}" -gt 0 ] || { echo "$PROG: at least one --file is required" >&2; exit 1; }
  local REPO; REPO="$(resolve_repo)"
  [ -n "$BRANCH" ] || BRANCH="$(gen_branch)"
  : "${MESSAGE:=mayfly: preview ${#FILES[@]} file(s)}"
  publish "$REPO" "$BRANCH" "$MESSAGE" "${FILES[@]}"
  [ "$OPEN" -eq 1 ] && open_url "$FIRST_URL"
  return 0
}

cmd_keep() {
  local PATHARG="" FILE="" SRC_BRANCH="" MESSAGE="" OPEN=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -p|--path)    PATHARG="$2"; shift 2;;
      -f|--file)    FILE="$2"; shift 2;;
      -b|--branch)  SRC_BRANCH="$2"; shift 2;;
      -m|--message) MESSAGE="$2"; shift 2;;
      -r|--repo)    REPO_ARG="$2"; shift 2;;
      --open)       OPEN=1; shift;;
      -h|--help)    usage; exit 0;;
      *) echo "$PROG: unknown argument: $1" >&2; usage; exit 1;;
    esac
  done
  [ -n "$PATHARG" ] || { echo "$PROG: --path is required" >&2; exit 1; }
  [ -n "$FILE" ]    || { echo "$PROG: --file is required" >&2; exit 1; }
  local REPO; REPO="$(resolve_repo)"
  local DEF; DEF="$(gh api "repos/$REPO" -q .default_branch)"
  : "${MESSAGE:=keep: $PATHARG}"

  # Resolve source content as base64 (local file, or a file on a preview branch).
  TMPD="$(mktemp -d)"; trap 'rm -rf "${TMPD:-}"' EXIT
  if [ -n "$SRC_BRANCH" ]; then
    gh api "repos/$REPO/contents/$FILE?ref=$SRC_BRANCH" -q .content | tr -d '\n' > "$TMPD/b64" \
      || { echo "$PROG: cannot read $FILE on $SRC_BRANCH" >&2; exit 1; }
  else
    [ -f "$FILE" ] || { echo "$PROG: file not found: $FILE" >&2; exit 1; }
    base64 < "$FILE" | tr -d '\n' > "$TMPD/b64"
  fi

  local DEST="$DOCS_DIR/$PATHARG"
  local KEEP_BRANCH; KEEP_BRANCH="keep/$(date +%Y%m%d-%H%M%S)-$RANDOM"
  local BASE_SHA; BASE_SHA="$(gh api "repos/$REPO/git/ref/heads/$DEF" -q .object.sha)"
  gh api -X POST "repos/$REPO/git/refs" -f ref="refs/heads/$KEEP_BRANCH" -f sha="$BASE_SHA" >/dev/null
  echo "$PROG: created keep branch '$KEEP_BRANCH'" >&2

  # Place the file at docs/<path> on the keep branch (update if it already exists).
  # Note: gh prints the error body to stdout on 404, so guard on exit status.
  local EXIST_SHA=""
  EXIST_SHA="$(gh api "repos/$REPO/contents/$DEST?ref=$KEEP_BRANCH" -q .sha 2>/dev/null)" || EXIST_SHA=""
  {
    printf '{"message":"%s","branch":"%s","content":"' "$(json_escape "$MESSAGE")" "$KEEP_BRANCH"
    cat "$TMPD/b64"
    printf '"'
    [ -n "$EXIST_SHA" ] && printf ',"sha":"%s"' "$EXIST_SHA"
    printf '}'
  } > "$TMPD/put.json"
  gh api -X PUT "repos/$REPO/contents/$DEST" --input "$TMPD/put.json" >/dev/null
  echo "$PROG: placed $DEST on $KEEP_BRANCH" >&2

  # Open a PR into the default branch.
  local PR_URL PR_NUM
  PR_URL="$(gh api -X POST "repos/$REPO/pulls" \
    -f title="$MESSAGE" -f head="$KEEP_BRANCH" -f base="$DEF" \
    -f body="Promote \`$DEST\` to keep it (published via GitHub Pages on merge)." \
    -q .html_url)"
  PR_NUM="$(gh api "repos/$REPO/pulls?head=$(printf '%s' "$REPO" | cut -d/ -f1):$KEEP_BRANCH&state=open" -q '.[0].number // empty')"
  echo "$PROG: opened PR $PR_URL" >&2

  cat <<EOF
{
  "pr": { "url": "$(json_escape "$PR_URL")", "number": ${PR_NUM:-null} },
  "path": "$(json_escape "$DEST")",
  "pages_path": "$(json_escape "$PATHARG")",
  "branch": { "name": "$(json_escape "$KEEP_BRANCH")", "url": "$(json_escape "https://github.com/$REPO/tree/$KEEP_BRANCH")" }
}
EOF
  [ "$OPEN" -eq 1 ] && open_url "$PR_URL"
  return 0
}

cmd_list() {
  while [ $# -gt 0 ]; do
    case "$1" in
      -r|--repo) REPO_ARG="$2"; shift 2;;
      -h|--help) usage; exit 0;;
      *) echo "$PROG: unknown argument: $1" >&2; usage; exit 1;;
    esac
  done
  local REPO; REPO="$(resolve_repo)"
  local DEF; DEF="$(gh api "repos/$REPO" -q .default_branch)"
  local branches; branches="$(gh api "repos/$REPO/branches" --paginate -q '.[].name' | grep "^$PREVIEW_PREFIX" || true)"

  local ITEMS="" b date rid run_url arts changed files_json path aname aid url entry
  while IFS= read -r b; do
    [ -n "$b" ] || continue
    date="$(gh api "repos/$REPO/commits/$b" -q .commit.committer.date 2>/dev/null || true)"
    rid="$(gh api "repos/$REPO/actions/runs?branch=$b&per_page=1" -q '.workflow_runs[0].id // empty' 2>/dev/null || true)"
    # Files pushed onto the branch = what it adds over the default branch.
    # Artifact name == path with '/'→'_' (see preview.yml); link to the artifact
    # when the run built one, else to the raw file on the branch so 'list' is
    # never empty just because the workflow hasn't run (or doesn't exist).
    changed="$(gh api "repos/$REPO/compare/$DEF...$b" -q '.files[].filename' 2>/dev/null || true)"
    if [ -n "$rid" ]; then
      run_url="\"https://github.com/$REPO/actions/runs/$rid\""
      arts="$(gh api "repos/$REPO/actions/runs/$rid/artifacts" -q '.artifacts[] | "\(.name)\t\(.id)"' 2>/dev/null || true)"
    else
      run_url="null"; arts=""
    fi
    files_json=""
    while IFS= read -r path; do
      [ -n "$path" ] || continue
      aname="$(printf '%s' "$path" | tr '/' '_')"
      aid="$(printf '%s\n' "$arts" | awk -F'\t' -v n="$aname" '$1==n{print $2; exit}')"
      if [ -n "$aid" ]; then
        url="https://github.com/$REPO/actions/runs/$rid/artifacts/$aid"
      else
        url="https://github.com/$REPO/blob/$b/$path"
      fi
      files_json="${files_json:+$files_json, }{ \"name\": \"$(json_escape "$path")\", \"url\": \"$(json_escape "$url")\" }"
    done <<< "$changed"
    entry="    { \"branch\": \"$(json_escape "$b")\", \"updated\": \"$(json_escape "$date")\", \"run\": $run_url, \"files\": [$files_json] }"
    ITEMS="${ITEMS:+$ITEMS,
}$entry"
  done <<< "$branches"

  printf '{\n  "previews": [\n%s\n  ]\n}\n' "$ITEMS"
}

cmd_delete() {
  local ALL=0; local BRANCHES=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -b|--branch)    BRANCHES+=("$2"); shift 2;;
      --all-previews) ALL=1; shift;;
      -r|--repo)      REPO_ARG="$2"; shift 2;;
      -h|--help)      usage; exit 0;;
      *) echo "$PROG: unknown argument: $1" >&2; usage; exit 1;;
    esac
  done
  local REPO; REPO="$(resolve_repo)"
  local DEF; DEF="$(gh api "repos/$REPO" -q .default_branch)"

  if [ "$ALL" -eq 1 ]; then
    local extra; extra="$(gh api "repos/$REPO/branches" --paginate -q '.[].name' | grep "^$PREVIEW_PREFIX" || true)"
    while IFS= read -r b; do [ -n "$b" ] && BRANCHES+=("$b"); done <<< "$extra"
  fi
  [ "${#BRANCHES[@]}" -gt 0 ] || { echo "$PROG: nothing to delete (use -b or --all-previews)" >&2; exit 1; }

  local DELETED="" b
  for b in "${BRANCHES[@]}"; do
    if [ "$b" = "$DEF" ]; then echo "$PROG: skip default branch '$DEF'" >&2; continue; fi
    if gh api -X DELETE "repos/$REPO/git/refs/heads/$b" >/dev/null 2>&1; then
      echo "$PROG: deleted '$b'" >&2
      DELETED="${DELETED:+$DELETED,}\"$(json_escape "$b")\""
    else
      echo "$PROG: could not delete '$b' (missing?)" >&2
    fi
  done
  printf '{ "deleted": [%s] }\n' "$DELETED"
}

cmd_completion() {
  case "${1:-}" in
    bash) cat <<'BASH'
_mayfly() {
  local cur cmds sub
  cur="${COMP_WORDS[COMP_CWORD]}"
  cmds="push keep list delete integrate completion"
  if [ "$COMP_CWORD" -eq 1 ]; then
    COMPREPLY=( $(compgen -W "$cmds" -- "$cur") ); return
  fi
  sub="${COMP_WORDS[1]}"
  case "$sub" in
    push)       COMPREPLY=( $(compgen -W "-b --branch -f --file -m --message -r --repo --open -h --help" -- "$cur") );;
    keep)       COMPREPLY=( $(compgen -W "-p --path -f --file -b --branch -m --message -r --repo --open -h --help" -- "$cur") );;
    delete)     COMPREPLY=( $(compgen -W "-b --branch --all-previews -r --repo -h --help" -- "$cur") );;
    list)       COMPREPLY=( $(compgen -W "-r --repo -h --help" -- "$cur") );;
    integrate)  COMPREPLY=( $(compgen -W "--force -h --help" -- "$cur") );;
    completion) COMPREPLY=( $(compgen -W "bash zsh" -- "$cur") );;
  esac
}
complete -F _mayfly mayfly
BASH
      ;;
    zsh) cat <<'ZSH'
#compdef mayfly
_mayfly() {
  local -a cmds
  cmds=(push:'throwaway preview' keep:'promote via PR' list:'list previews' delete:'delete branches' integrate:'scaffold into a repo' completion:'shell completion')
  if (( CURRENT == 2 )); then
    _describe 'command' cmds; return
  fi
  case "${words[2]}" in
    push)       _arguments '*'{-f,--file}'[file]:file:_files' {-b,--branch}'[branch]:branch:' {-m,--message}'[message]:msg:' {-r,--repo}'[repo]:repo:' '--open[open in browser]' ;;
    keep)       _arguments {-p,--path}'[pages path]:path:' {-f,--file}'[file]:file:_files' {-b,--branch}'[source branch]:branch:' {-m,--message}'[message]:msg:' {-r,--repo}'[repo]:repo:' '--open[open in browser]' ;;
    delete)     _arguments '*'{-b,--branch}'[branch]:branch:' '--all-previews[delete all preview/*]' {-r,--repo}'[repo]:repo:' ;;
    list)       _arguments {-r,--repo}'[repo]:repo:' ;;
    integrate)  _arguments '--force[overwrite existing files]' ;;
    completion) _values 'shell' bash zsh ;;
  esac
}
_mayfly "$@"
ZSH
      ;;
    *) echo "$PROG: usage: $PROG completion <bash|zsh>" >&2; exit 1;;
  esac
}

cmd_integrate() {
  local FORCE=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --force)   FORCE=1; shift;;
      -h|--help) usage; exit 0;;
      *) echo "$PROG: unknown argument: $1" >&2; usage; exit 1;;
    esac
  done
  [ -d .git ] || echo "$PROG: warning: '$PWD' is not a git repo root" >&2
  mkdir -p .github/workflows

  _wf() { # _wf <path>  (content on stdin)
    if [ -e "$1" ] && [ "$FORCE" -ne 1 ]; then
      cat >/dev/null
      echo "$PROG: exists, skipped $1 (use --force to overwrite)" >&2
    else
      cat > "$1"
      echo "$PROG: wrote $1" >&2
    fi
  }

  _wf .github/workflows/mayfly-preview.yml <<'PREVIEW_YML'
name: mayfly preview

# Installed by `mayfly integrate`. Turns HTML pushed to mayfly/* branches into
# browser-viewable artifacts. PR commenting is done by .github/mayfly-preview.

on:
  push:
    branches: ['mayfly/**']

permissions:
  contents: read

jobs:
  detect:
    runs-on: ubuntu-latest
    outputs:
      files: ${{ steps.collect.outputs.files }}
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
        with:
          fetch-depth: 0
          persist-credentials: false
      - id: collect
        env:
          BEFORE_SHA: ${{ github.event.before }}
          AFTER_SHA: ${{ github.sha }}
        run: |
          set -euo pipefail
          if [ -z "$BEFORE_SHA" ] \
             || [ "$BEFORE_SHA" = "0000000000000000000000000000000000000000" ] \
             || ! git cat-file -e "$BEFORE_SHA" 2>/dev/null; then
            CHANGED=$(git ls-files '*.html')
          else
            CHANGED=$(git diff --name-only "$BEFORE_SHA" "$AFTER_SHA" -- '*.html')
          fi
          CHANGED=$(printf '%s\n' "$CHANGED" | while IFS= read -r f; do
            [ -n "$f" ] && [ -f "$f" ] && printf '%s\n' "$f"
          done)
          FILES=$(printf '%s\n' "$CHANGED" | grep -v '^$' | jq -R . | jq -c -s .)
          echo "files=$FILES" >> "$GITHUB_OUTPUT"

  upload:
    needs: detect
    if: needs.detect.outputs.files != '[]'
    runs-on: ubuntu-latest
    permissions:
      contents: read
    strategy:
      fail-fast: false
      matrix:
        file: ${{ fromJSON(needs.detect.outputs.files) }}
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
        with:
          persist-credentials: false
      - id: name
        env:
          FILE: ${{ matrix.file }}
        run: echo "name=$(printf '%s' "$FILE" | tr '/' '_')" >> "$GITHUB_OUTPUT"
      # Artifact previews are served without a charset header; inject
      # <meta charset="utf-8"> into the uploaded copy when the file has no
      # declaration in its first 1024 bytes.
      - name: Ensure charset declaration
        env:
          FILE: ${{ matrix.file }}
        run: |
          set -euo pipefail
          if ! head -c 1024 "$FILE" | grep -qi 'charset='; then
            perl -0777 -pi -e 's/\A(\s*<!doctype[^>]*>)/$1\n<meta charset="utf-8">/i
                               or s/\A/<meta charset="utf-8">\n/' "$FILE"
            echo "mayfly: injected <meta charset=\"utf-8\"> into $FILE"
          fi
      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: ${{ steps.name.outputs.name }}
          path: ${{ matrix.file }}
          if-no-files-found: error
          archive: false
PREVIEW_YML

  _wf .github/workflows/mayfly-cleanup.yml <<'CLEANUP_YML'
name: mayfly cleanup

# Installed by `mayfly integrate`. Deletes mayfly/* preview branches idle for
# 90 days (matches the Actions artifact default retention). Only mayfly/*
# branches are touched.

on:
  schedule:
    - cron: '0 0 * * *' # daily 00:00 UTC
  workflow_dispatch:

permissions:
  contents: write

jobs:
  cleanup:
    runs-on: ubuntu-latest
    env:
      GH_TOKEN: ${{ github.token }}
      REPO: ${{ github.repository }}
      STALE_DAYS: '90'
    steps:
      - run: |
          set -euo pipefail
          CUTOFF=$(date -u -d "$STALE_DAYS days ago" +%s)
          gh api "repos/$REPO/branches" --paginate -q '.[].name' | while IFS= read -r b; do
            case "$b" in mayfly/*) ;; *) continue;; esac
            DATE=$(gh api "repos/$REPO/commits/$b" -q '.commit.committer.date')
            TS=$(date -u -d "$DATE" +%s)
            if [ "$TS" -lt "$CUTOFF" ]; then
              echo "Deleting stale branch: $b"
              gh api -X DELETE "repos/$REPO/git/refs/heads/$b"
            fi
          done
CLEANUP_YML

  _wf .github/mayfly-preview <<'CLI'
#!/usr/bin/env bash
#
# mayfly-preview — post a local HTML file's preview onto a PR.
# Installed by `mayfly integrate`. Pushes the file to a mayfly/* branch (CI
# builds the artifact via .github/workflows/mayfly-preview.yml) and comments
# the preview URL on the PR.
#
#   mayfly-preview -f <file> [-f <file> ...] --pr <N> [--target comment|description|both]
#
set -euo pipefail
PROG="mayfly-preview"
PREFIX="mayfly/"
MARK='<!-- mayfly-preview -->'
DS='<!-- mayfly-preview:start -->'
DE='<!-- mayfly-preview:end -->'

die() { echo "$PROG: $*" >&2; exit 1; }
esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

FILES=(); PR=""; TARGET="comment"; MESSAGE=""; REPO_ARG=""
while [ $# -gt 0 ]; do
  case "$1" in
    -f|--file)    FILES+=("$2"); shift 2;;
    --pr)         PR="$2"; shift 2;;
    --target)     TARGET="$2"; shift 2;;
    -m|--message) MESSAGE="$2"; shift 2;;
    -r|--repo)    REPO_ARG="$2"; shift 2;;
    -h|--help)    sed -n '3,9p' "$0"; exit 0;;
    *) die "unknown argument: $1";;
  esac
done
[ "${#FILES[@]}" -gt 0 ] || die "at least one --file is required"
[ -n "$PR" ] || die "--pr <number> is required"
case "$TARGET" in comment|description|both) ;; *) die "--target must be comment|description|both";; esac

REPO="${REPO_ARG:-${MAYFLY_REPO:-}}"
[ -z "$REPO" ] && REPO="$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || true)"
[ -n "$REPO" ] || die "cannot determine repo; run inside the repo or set MAYFLY_REPO"
: "${MESSAGE:=mayfly: preview for PR #$PR}"

DEF="$(gh api "repos/$REPO" -q .default_branch)"
BASE="$(gh api "repos/$REPO/git/ref/heads/$DEF" -q .object.sha)"
BRANCH="$PREFIX$(date +%Y%m%d-%H%M%S)-$RANDOM"
gh api -X POST "repos/$REPO/git/refs" -f ref="refs/heads/$BRANCH" -f sha="$BASE" >/dev/null
BASE_TREE="$(gh api "repos/$REPO/git/commits/$BASE" -q .tree.sha)"

TMPD="$(mktemp -d)"; trap 'rm -rf "${TMPD:-}"' EXIT
ENTRIES=""; USED=""; DESTS=()
for f in "${FILES[@]}"; do
  [ -f "$f" ] || die "file not found: $f"
  b="$(basename "$f")"; stem="$b"; ext=""
  case "$b" in *.*) stem="${b%.*}"; ext=".${b##*.}";; esac
  d="$b"; n=1
  while case " $USED " in *" $d "*) true;; *) false;; esac; do n=$((n + 1)); d="$stem-$n$ext"; done
  USED="$USED $d"; DESTS+=("$d")
  { printf '{"encoding":"base64","content":"'; base64 < "$f" | tr -d '\n'; printf '"}'; } > "$TMPD/b.json"
  sha="$(gh api -X POST "repos/$REPO/git/blobs" --input "$TMPD/b.json" -q .sha)"
  ENTRIES="${ENTRIES:+$ENTRIES,}{\"path\":\"$d\",\"mode\":\"100644\",\"type\":\"blob\",\"sha\":\"$sha\"}"
done
printf '{"base_tree":"%s","tree":[%s]}' "$BASE_TREE" "$ENTRIES" > "$TMPD/t.json"
TREE="$(gh api -X POST "repos/$REPO/git/trees" --input "$TMPD/t.json" -q .sha)"
COMMIT="$(gh api -X POST "repos/$REPO/git/commits" -f message="$MESSAGE" -f tree="$TREE" -f "parents[]=$BASE" -q .sha)"
gh api -X PATCH "repos/$REPO/git/refs/heads/$BRANCH" -f sha="$COMMIT" >/dev/null
echo "$PROG: pushed ${#DESTS[@]} file(s) to $BRANCH" >&2

RID=""
echo -n "$PROG: waiting for run" >&2
for i in $(seq 1 40); do
  RID="$(gh api "repos/$REPO/actions/runs?head_sha=$COMMIT&event=push&per_page=1" -q '.workflow_runs[0].id // empty')"
  [ -n "$RID" ] && break; echo -n "." >&2; sleep 3
done
echo >&2
[ -n "$RID" ] || die "timed out finding workflow run (is mayfly-preview.yml pushed?)"
echo "$PROG: building preview — https://github.com/$REPO/actions/runs/$RID" >&2
gh run watch "$RID" -R "$REPO" --interval 2 --exit-status 1>&2 || echo "$PROG: warning: run did not complete cleanly" >&2
ARTS="$(gh api "repos/$REPO/actions/runs/$RID/artifacts" -q '.artifacts[] | "\(.name)\t\(.id)"' 2>/dev/null || true)"

PREVIEW="$TMPD/preview.md"
{
  printf '🦋 **mayfly preview**\n\n'
  for d in "${DESTS[@]}"; do
    id="$(printf '%s\n' "$ARTS" | awk -F'\t' -v n="$d" '$1==n{print $2; exit}')"
    [ -n "$id" ] && printf -- '- [%s](https://github.com/%s/actions/runs/%s/artifacts/%s)\n' "$d" "$REPO" "$RID" "$id"
  done
  printf '\nOpen an artifact, then view it in your browser. Expires in 90 days.\n'
} > "$PREVIEW"

case "$TARGET" in
  comment|both)
    { printf '%s\n' "$MARK"; cat "$PREVIEW"; } > "$TMPD/c.md"
    CID="$(gh api "repos/$REPO/issues/$PR/comments" --paginate \
          --jq 'map(select(.body | contains("<!-- mayfly-preview -->"))) | .[0].id // empty')"
    if [ -n "$CID" ]; then
      gh api --method PATCH "repos/$REPO/issues/comments/$CID" -F "body=@$TMPD/c.md" >/dev/null
    else
      gh api --method POST "repos/$REPO/issues/$PR/comments" -F "body=@$TMPD/c.md" >/dev/null
    fi
    ;;
esac
case "$TARGET" in
  description|both)
    CUR="$(gh api "repos/$REPO/pulls/$PR" --jq '.body // ""')"
    STRIPPED="$(printf '%s' "$CUR" | awk -v s="$DS" -v e="$DE" '$0==s{skip=1} skip==0{print} $0==e{skip=0}')"
    { printf '%s' "$STRIPPED"; printf '\n\n%s\n' "$DS"; cat "$PREVIEW"; printf '%s\n' "$DE"; } > "$TMPD/d.md"
    gh api --method PATCH "repos/$REPO/pulls/$PR" -F "body=@$TMPD/d.md" >/dev/null
    ;;
esac
echo "$PROG: posted preview to PR #$PR ($TARGET)" >&2
CLI
  chmod +x .github/mayfly-preview 2>/dev/null || true

  cat >&2 <<'NEXT'
mayfly: integration scaffolded.
  1) Commit & push the new files:
       .github/workflows/mayfly-preview.yml
       .github/workflows/mayfly-cleanup.yml
       .github/mayfly-preview
  2) Post a local file's preview onto a PR:
       .github/mayfly-preview -f page.html --pr <number>
     (--target comment|description|both)
NEXT
}

case "${1:-}" in
  push)        shift; cmd_push "$@";;
  keep)        shift; cmd_keep "$@";;
  list)        shift; cmd_list "$@";;
  delete|rm)   shift; cmd_delete "$@";;
  integrate)   shift; cmd_integrate "$@";;
  completion)  shift; cmd_completion "$@";;
  -h|--help|"") usage; exit 0;;
  -*)          cmd_push "$@";;
  *)           echo "$PROG: unknown command: $1" >&2; usage; exit 1;;
esac
